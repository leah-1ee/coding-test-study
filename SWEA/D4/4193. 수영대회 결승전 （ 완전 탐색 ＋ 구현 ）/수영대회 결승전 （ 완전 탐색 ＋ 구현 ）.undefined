import java.util.ArrayDeque;
import java.util.Deque;
import java.util.Scanner;

public class Solution {

    static int[] dr = {0, 0, 1, -1};
    static int[] dc = {1, -1, 0, 0};

    static int bfs(int N, int[][] grid, int sr, int sc, int er, int ec) {
        final int INF = Integer.MAX_VALUE;
        int[][] dist = new int[N][N];
        for (int[] row : dist) java.util.Arrays.fill(row, INF);
        dist[sr][sc] = 0;

        Deque<int[]> queue = new ArrayDeque<>();
        queue.add(new int[]{sr, sc});

        while (!queue.isEmpty()) {
            int[] cur = queue.poll();
            int r = cur[0], c = cur[1];
            int time = dist[r][c];

            for (int d = 0; d < 4; d++) {
                int nr = r + dr[d];
                int nc = c + dc[d];

                if (nr >= 0 && nr < N && nc >= 0 && nc < N && grid[nr][nc] != 1) {
                    int arrival;
                    if (grid[nr][nc] == 0) {
                        arrival = time + 1;
                    } else { // grid == 2
                        arrival = time + (2 - time % 3) + 1;
                    }

                    if (arrival < dist[nr][nc]) {
                        dist[nr][nc] = arrival;
                        queue.add(new int[]{nr, nc});
                    }
                }
            }
        }

        return dist[er][ec] == INF ? -1 : dist[er][ec];
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int T = Integer.parseInt(sc.nextLine().trim());

        StringBuilder sb = new StringBuilder();

        for (int tc = 1; tc <= T; tc++) {
            int N = Integer.parseInt(sc.nextLine().trim());
            int[][] grid = new int[N][N];
            for (int i = 0; i < N; i++) {
                String[] tokens = sc.nextLine().trim().split("\\s+");
                for (int j = 0; j < N; j++) {
                    grid[i][j] = Integer.parseInt(tokens[j]);
                }
            }

            String[] startTok = sc.nextLine().trim().split("\\s+");
            int startR = Integer.parseInt(startTok[0]);
            int startC = Integer.parseInt(startTok[1]);

            String[] endTok = sc.nextLine().trim().split("\\s+");
            int endR = Integer.parseInt(endTok[0]);
            int endC = Integer.parseInt(endTok[1]);

            int answer = bfs(N, grid, startR, startC, endR, endC);

            sb.append("#").append(tc).append(" ").append(answer).append("\n");
        }

        System.out.print(sb);
    }
}